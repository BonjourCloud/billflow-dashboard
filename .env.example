# Required. Clerk publishable key (must match CLERK_PUBLISHABLE_KEY on the server).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Backend API origin. Required for production builds; development falls back
# to http://localhost:5001.
# Production (Vercel): https://api.billwill.site
VITE_API_URL=http://localhost:5001

# Optional. Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave unset in
# development and preview; set it for Production only. Baked in at build time,
# so changing it needs a frontend redeploy.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
