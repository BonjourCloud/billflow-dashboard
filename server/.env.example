# development | production | test
NODE_ENV=development
PORT=5001

# Reverse-proxy hops in front of the API, used for client IPs in rate limiting.
# 0 locally; 1 behind Render's proxy (set in render.yaml).
TRUST_PROXY=0

# Frontend origin(s) allowed by CORS. Comma-separate multiple origins; no paths.
# Required when NODE_ENV=production.
# Production: https://billwill.site,https://www.billwill.site
CLIENT_URL=http://localhost:8080

# Required. MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<db-name>?retryWrites=true&w=majority

# Required. From the Clerk dashboard (API keys).
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional. Comma-separated Clerk user IDs that always have admin access.
ADMIN_CLERK_USER_IDS=
# Optional: Clerk user id (user_...) of the shared demo account. Enables the
# "Try the demo" button and the demo reset. Must not be an admin.
DEMO_CLERK_USER_ID=

# Optional. Required together to enable branding logo uploads.
# AWS_S3_BUCKET is required in production when credentials are set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
